# ==========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================
# 🔐 DO NOT commit this file to version control
# 🔐 Keep this file secure and private

# Server Configuration
PORT=5000
NODE_ENV=production
SERVER_URL=https://your-production-domain.com

# Database - MongoDB Atlas (Production)
# ⚠️ Replace with your production database URI
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/elmnsa-prod?retryWrites=true&w=majority

# JWT Security - MUST be random and at least 32 characters
# ⚠️ Generate a random string for production
JWT_SECRET=generate_a_random_32_character_string_here_for_production_use_only
JWT_EXPIRE=7d

# AI - Groq API (Get from https://console.groq.com)
# ⚠️ Replace with your production API key
GROQ_API_KEY=your_production_groq_api_key_here

# GROQ Model
GROQ_MODEL=mixtral-8x7b-32768

# CORS - Production Frontend URLs
# ⚠️ Set to your actual production frontend domain
CORS_ORIGIN=https://your-production-domain.com

# File Upload Configuration
MAX_FILE_SIZE=52428800
UPLOAD_DIR=/app/uploads

# Bcrypt Configuration
BCRYPT_ROUNDS=12

# Email Configuration (if needed for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@your-domain.com

# Logging
LOG_LEVEL=info
LOG_FILE=/app/logs/app.log

# Security Headers
ENABLE_HELMET=true
ENABLE_RATE_LIMIT=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL=3600

# Database Connection Pool
DB_POOL_MIN=5
DB_POOL_MAX=20

# Socket.IO Configuration
SOCKET_IO_ENABLED=true
SOCKET_IO_CORS_ORIGIN=https://your-production-domain.com

# Monitoring (if using services like DataDog, New Relic, etc)
MONITORING_ENABLED=false
MONITORING_SERVICE=datadog
MONITORING_API_KEY=your_monitoring_key

# Redis Configuration (if needed for caching/sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Feature Flags
FEATURE_DEVICE_MANAGEMENT=true
FEATURE_AI_CHAT=true
FEATURE_VIDEO_STREAMING=true

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# ==========================================
# ⚠️  SECURITY REMINDERS
# ==========================================
# 1. Never commit .env.production to version control
# 2. Use strong, random values for all secrets
# 3. Rotate secrets regularly
# 4. Use environment-specific configurations
# 5. Monitor access to production secrets
# 6. Use a secrets management service (e.g., AWS Secrets Manager, HashiCorp Vault)
