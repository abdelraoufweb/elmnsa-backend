{
  "version": 2,
  "name": "elmnsa-backend",
  "env": {
    "NODE_ENV": "production",
    "MONGODB_URI": "@mongodb_uri",
    "JWT_SECRET": "@jwt_secret",
    "GROQ_API_KEY": "@groq_api_key",
    "GROQ_MODEL": "@groq_model",
    "CORS_ORIGIN": "@cors_origin",
    "BCRYPT_ROUNDS": "@bcrypt_rounds"
  },
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node@3"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ],
  "functions": {
    "index.js": {
      "maxDuration": 30,
      "memory": 1024
    }
  }
}
