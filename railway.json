{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "npm start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheck": {
      "interval": 10,
      "timeout": 5,
      "retries": 3,
      "startPeriod": 30,
      "command": ["CMD", "curl", "--fail", "http://localhost:${PORT:-5000}/api/health"]
    }
  }
}
